# Copia in .env con `npm run env:init` (genera password casuali). Il file .env non va mai in git.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=outsmart_cms
DB_USER=cms
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Indirizzo con cui si apre l'admin (controllo dell'origine sulle richieste)
APP_ORIGIN=http://localhost:3000
# 1 solo se l'app sta dietro un proxy fidato che AGGIUNGE l'indirizzo del client in coda a X-Forwarded-For (si legge l'ultimo valore).
# Senza, l'indirizzo è ignoto e resta solo il limite di tentativi per account: in produzione, dietro proxy, va messo a 1
TRUST_PROXY=0
# Dove viene scritto il sito pubblicato (default: dist/ nella cartella del progetto)
# SITE_OUT_DIR=
# Dove finiscono le immagini caricate dall'admin (default: media/ nella cartella del progetto) e limite di dimensione
# MEDIA_DIR=
# MAX_UPLOAD_MB=10
# Chiave che cifra la password SMTP salvata da Admin > Email (mai in git, non cambiarla: la password salvata non si leggerebbe più). npm run env:init la genera.
SETTINGS_SECRET=
# Moduli del sito: email delle richieste (la richiesta si salva comunque nel database). Di norma si configura da Admin > Email;
# le variabili qui sotto servono da ripiego (le impostazioni salvate nell'admin hanno la precedenza).
# SMTP_HOST=
# SMTP_PORT=587
# 1 solo per la porta 465 (TLS diretto); con 587 la connessione passa a TLS da sola
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASSWORD=
# Mittente: un indirizzo del dominio autorizzato dal server SMTP (chi scrive va in Reply-To)
# MAIL_FROM=
# Solo se il sito statico sta a un indirizzo diverso dall'app (origini separate da virgola). Di norma non serve: /api/ sta sullo stesso dominio.
# FORM_ALLOWED_ORIGINS=
# Sale per rendere anonimo l'indirizzo IP nel limite di richieste (npm run env:init lo genera)
IP_HASH_SECRET=
# Limiti e pulizia (facoltativi)
# Spazio massimo per le immagini caricate, in MB (default 1024)
# MEDIA_QUOTA_MB=1024
# Mesi di conservazione delle richieste dei moduli per `npm run purge` (senza, le richieste non si eliminano da sole)
# FORM_RETENTION_MONTHS=12

# Installazione e template (facoltativi; di norma non servono)
# INSTALL_TOKEN=            chiave della pagina /install scelta da te (almeno 16 caratteri); altrimenti se ne crea una in data/install-token
# DATA_DIR=                 stato dell'installazione (default: data/)
# TEMPLATES_DIR=            dove stanno i template (default: templates/)
# ENV_FILE=                 percorso del file di configurazione (default: .env nella cartella del progetto)
# CMS_TEMPLATE=             id del template da usare al posto di quello attivo (script e prove)
# CMS_RENDER=inline         esegue l'HTML dei template nel processo principale, SENZA isolamento: solo per sviluppare un template
# ADMIN_HOSTS=              indirizzi (con porta se serve, separati da virgola) da cui esistono /admin e /install; da altri: 404. Consigliato: admin su un indirizzo diverso dal sito
# ALLOW_TEMPLATE_UPLOAD=0   spegne il caricamento di template da zip (admin e installazione guidata)
# CMS_RENDER_WRAPPER=       comando che avvolge il processo isolato dei template, come lista JSON: ["unshare","-Urn"] (Linux) o ["bwrap", ...]
