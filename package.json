{
  "name": "outsmart-cms",
  "private": true,
  "type": "module",
  "description": "CMS interno Outsmart: stile globale a token + pagine a blocchi. Prima prova: sito Mammano Traslochi.",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "shots": "node templates/mammano/tools/shots.mjs",
    "diff": "node templates/mammano/tools/diff.mjs",
    "import": "node templates/mammano/tools/import-prototype.mjs",
    "validate": "node scripts/validate-content.mjs",
    "build": "node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs",
    "compare": "node templates/mammano/tools/compare-html.mjs",
    "env:init": "node scripts/init-env.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "admin:user": "node scripts/create-user.mjs",
    "test": "node --import ./tests/setup.mjs --test --test-concurrency=1 tests/*.test.mjs",
    "dev": "next dev -p 3000",
    "start": "next start -p 3000",
    "build:admin": "next build",
    "probe:security": "node scripts/probe-security.mjs",
    "purge": "node scripts/purge-data.mjs",
    "template:pack": "node scripts/template-pack.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1",
    "smtp-server": "^3.19.13"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fflate": "^0.8.3",
    "mysql2": "^3.24.4",
    "next": "^15.5.25",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=20.9"
  }
}
