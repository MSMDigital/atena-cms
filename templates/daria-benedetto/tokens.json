{
  "meta": {
    "site": "daria-benedetto",
    "version": 1
  },
  "colors": {
    "brand": "#B9472B",
    "brandTint": "#D45C3E",
    "whatsapp": "#1fa855"
  },
  "surfaces": {
    "light": {
      "bg": "#FFFFFF",
      "ink": "#123A42",
      "inkSoft": "#2B4E55",
      "muted": "#3D5F66",
      "line": "rgba(18,58,66,.12)",
      "rule": "#123A42",
      "accent": "@brand",
      "fill": "#123A42"
    },
    "dark": {
      "bg": "#123A42",
      "ink": "#FFFFFF",
      "inkSoft": "#D7EEF1",
      "muted": "#9CC4CB",
      "line": "rgba(255,255,255,.16)",
      "rule": "#FFFFFF",
      "accent": "#4FB2C2",
      "fill": "@brand"
    },
    "brand": {
      "bg": "#D7EEF1",
      "ink": "#123A42",
      "inkSoft": "#2B4E55",
      "muted": "#3D5F66",
      "line": "rgba(18,58,66,.14)",
      "rule": "#123A42",
      "accent": "@brand",
      "fill": "#123A42"
    }
  },
  "typography": {
    "fluid": {
      "from": 390,
      "to": 1440
    },
    "fonts": {
      "body": "DM Sans",
      "heading": "Outfit",
      "fallback": "system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "extraWeights": [
        300,
        400,
        500,
        600,
        700
      ],
      "subsets": [
        "latin",
        "latin-ext"
      ]
    },
    "scale": {
      "h1": {
        "size": [
          38,
          64
        ],
        "weight": 500,
        "lineHeight": 1.05,
        "tracking": "-0.02em",
        "max": 68
      },
      "h2": {
        "size": [
          30,
          46
        ],
        "weight": 500,
        "lineHeight": 1.1,
        "tracking": "-0.015em",
        "max": 50
      },
      "h3": {
        "size": [
          22,
          30
        ],
        "weight": 500,
        "lineHeight": 1.18,
        "tracking": "-0.01em",
        "max": 32
      },
      "h4": {
        "size": [
          19,
          23
        ],
        "weight": 500,
        "lineHeight": 1.25,
        "tracking": "-0.005em"
      },
      "h5": {
        "size": [
          17,
          19
        ],
        "weight": 600,
        "lineHeight": 1.3,
        "tracking": "0em"
      },
      "h6": {
        "size": [
          15,
          16
        ],
        "weight": 700,
        "lineHeight": 1.3,
        "tracking": "0.12em"
      },
      "lead": {
        "size": [
          18,
          21
        ],
        "weight": 400,
        "lineHeight": 1.55,
        "tracking": "0em"
      },
      "body": {
        "size": [
          17,
          18
        ],
        "weight": 400,
        "lineHeight": 1.65,
        "tracking": "0em"
      },
      "small": {
        "size": [
          15,
          15
        ]
      },
      "xs": {
        "size": [
          13,
          13
        ]
      },
      "micro": {
        "size": [
          12,
          12
        ]
      }
    },
    "display": {
      "hero": {
        "size": [
          38,
          64
        ],
        "max": 68
      },
      "marquee": {
        "size": [
          24,
          40
        ]
      },
      "list": {
        "size": [
          22,
          30
        ],
        "max": 32
      },
      "split": {
        "size": [
          28,
          42
        ]
      },
      "cta": {
        "size": [
          28,
          46
        ],
        "max": 50
      },
      "ctaWord": {
        "size": [
          96,
          192
        ],
        "max": 240
      },
      "zones": {
        "size": [
          28,
          50
        ]
      },
      "quote": {
        "size": [
          24,
          36
        ]
      },
      "footer": {
        "size": [
          26,
          30
        ]
      },
      "number": {
        "size": [
          88,
          128
        ],
        "max": 136
      },
      "pointNumber": {
        "size": [
          30,
          44
        ]
      }
    }
  },
  "buttons": {
    "effect": "fill",
    "radius": "999px",
    "minHeight": 52,
    "weight": 600
  },
  "layout": {
    "maxWidth": 1280,
    "gutter": "clamp(1.25rem, .5rem + 2.5vw, 2rem)",
    "section": "clamp(3.5rem, 2rem + 6vw, 7rem)",
    "headerHeight": 84,
    "headerHeightMobile": 72
  }
}
