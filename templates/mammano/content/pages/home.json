      "firstOpen": true,
      "items": [
        {
          "question": {
            "it": "Quanto costa un trasloco a Lugano?"
          },
          "answer": {
            "it": "Dipende da volume, piani, accessi, distanza e servizi extra come imballaggio, lift o deposito. Per questo Mammano Traslochi fa prima un sopralluogo gratuito e poi invia un preventivo scritto e dettagliato, senza impegno."
          }
        },
        {
          "question": {
            "it": "Con quanto anticipo devo prenotare il trasloco?"
          },
          "answer": {
            "it": "Almeno 3–4 settimane prima, soprattutto per fine mese. Per urgenze chiamateci: verifichiamo subito la disponibilità."
          }
        },
        {
          "question": {
            "it": "Fate traslochi anche fuori dal Ticino?"
          },
          "answer": {
            "it": "Sì: in tutta la Svizzera e all'estero, verso Italia, Europa e resto del mondo, via strada, mare o aereo."
          }
        }
      ]
