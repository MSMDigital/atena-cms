      },
      "firstOpen": true,
      "items": [
        {
          "question": {
            "it": "Per quanto tempo posso lasciare i mobili in deposito?"
          },
          "answer": {
            "it": "Per il tempo che vi serve, da poche settimane a periodi più lunghi. Durata e costi li definiamo nel preventivo in base al volume."
          }
        },
        {
          "question": {
            "it": "Il deposito è sorvegliato?"
          },
          "answer": {
            "it": "Sì, i depositi Mammano sono videosorvegliati e i mobili vengono protetti e imballati prima dello stoccaggio."
          }
        },
        {
          "question": {
            "it": "Cosa succede agli oggetti sgomberati?"
          },
          "answer": {
            "it": "Separiamo i materiali e li consegniamo agli enti di smaltimento competenti. Gli oggetti che volete conservare li trasportiamo o li mettiamo in deposito."
          }
        },
        {
          "question": {
            "it": "Fate sgomberi anche senza trasloco?"
          },
          "answer": {
            "it": "Sì, lo sgombero di cantine, solai, appartamenti o uffici si può richiedere anche come servizio singolo."
          }
        }
      ]
