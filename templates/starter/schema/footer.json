{
  "title": "Footer",
  "type": "object",
  "properties": {
    "surface": {
      "title": "Superficie",
      "enum": [
        "light",
        "dark",
        "brand"
      ],
      "default": "dark",
      "description": "Colore di fondo: chiaro, scuro o colore del marchio (si cambiano da Stile)."
    },
    "text": {
      "$ref": "https://atena.cms/schema/common.json#/$defs/text",
      "title": "Testo"
    },
    "columns": {
      "title": "Colonne di link (facoltative)",
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "$ref": "https://atena.cms/schema/common.json#/$defs/text",
            "title": "Titolo della colonna"
          },
          "links": {
            "title": "Link",
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "$ref": "https://atena.cms/schema/common.json#/$defs/text",
                  "title": "Etichetta"
                },
                "link": {
                  "$ref": "https://atena.cms/schema/common.json#/$defs/link",
                  "title": "Link"
                },
                "cssClass": {
                  "type": "string",
                  "title": "Classe CSS (facoltativa)",
                  "description": "Una o più classi (separate da spazio) aggiunte alla voce, per darle uno stile o un comportamento particolare. Solo lettere, numeri, trattini e underscore.",
                  "pattern": "^[A-Za-z0-9_ -]{1,120}$",
                  "maxLength": 120
                }
              },
              "required": [
                "label",
                "link"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "links"
        ],
        "additionalProperties": false
      }
    },
    "legal": {
      "title": "Link legali (privacy, note legali…)",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "$ref": "https://atena.cms/schema/common.json#/$defs/text",
            "title": "Etichetta"
          },
          "link": {
            "$ref": "https://atena.cms/schema/common.json#/$defs/link",
            "title": "Link"
          },
          "cssClass": {
            "type": "string",
            "title": "Classe CSS (facoltativa)",
            "description": "Una o più classi (separate da spazio) aggiunte alla voce, per darle uno stile o un comportamento particolare. Solo lettere, numeri, trattini e underscore.",
            "pattern": "^[A-Za-z0-9_ -]{1,120}$",
            "maxLength": 120
          }
        },
        "required": [
          "label",
          "link"
        ],
        "additionalProperties": false
      }
    },
    "showCookiePreferences": {
      "title": "Mostra «Preferenze cookie»",
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "text"
  ],
  "additionalProperties": false
}