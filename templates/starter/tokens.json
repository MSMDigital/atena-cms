{
  "meta": {
    "site": "starter",
    "version": 1
  },
  "colors": {
    "brand": "#0f766e",
    "brandTint": "#5eead4",
    "whatsapp": "#1fa855"
  },
  "surfaces": {
    "light": {
      "bg": "#ffffff",
      "ink": "#0b0f17",
      "inkSoft": "#4a5263",
      "muted": "#8a91a0",
      "line": "#e4e6eb",
      "rule": "@ink",
      "accent": "@brand",
      "fill": "@brand"
    },
    "dark": {
      "bg": "#0b1f1e",
      "ink": "#f5f6f8",
      "inkSoft": "#a3a9b5",
